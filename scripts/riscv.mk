CROSS_COMPILE ?= riscv64-linux-gnu-
CC := $(CROSS_COMPILE)gcc
CXX := $(CROSS_COMPILE)g++
AR := $(CROSS_COMPILE)gcc-ar
RANLIB := $(CROSS_COMPILE)gcc-ranlib
READELF := $(CROSS_COMPILE)readelf

# This SDL profile doesn't use any target packages from pkg-config.
SDL2_CONFIG_ENV := env PKG_CONFIG_PATH= PKG_CONFIG_LIBDIR=/dev/null PKG_CONFIG_SYSROOT_DIR=
SDL2_PLATFORM_FLAGS := \
	-DCMAKE_SYSTEM_NAME=Linux \
	-DCMAKE_SYSTEM_PROCESSOR=riscv64 \
	-DSDL_X11=OFF \
	-DSDL_WAYLAND=OFF \
	-DSDL_DISKAUDIO=OFF \
	-DSDL_NUVIXVIDEO=ON \
	-DSDL_NUVIXAUDIO=ON
SDL2_REQUIRED_DRIVERS := SDL_VIDEO_DRIVER_NUVIX SDL_AUDIO_DRIVER_NUVIX
