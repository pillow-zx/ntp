new file mode 100644
index 0000000..a0faa11
--- /dev/null
+++ b/src/audio/nuvix/SDL_nuvixaudio.c
@@ -0,0 +1,173 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2025 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "../../SDL_internal.h"
+
+#ifdef SDL_AUDIO_DRIVER_NUVIX
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include "SDL_audio.h"
+
+#include "../SDL_sysaudio.h"
+
+#define NUVIX_AUDIO_DEVICE "/dev/audio"
+#define NUVIX_AUDIO_INFO   0x80104e00U
+#define NUVIX_POLL_WAIT_MS 50
+
+typedef struct
+{
+    Uint32 rate;
+    Uint32 channels;
+    Uint32 bits;
+    Uint32 period_bytes;
+} NuvixAudioInfo;
+
+SDL_COMPILE_TIME_ASSERT(nuvix_audio_info, sizeof(NuvixAudioInfo) == 16);
+
+struct SDL_PrivateAudioData
+{
+    int fd;
+    Uint8 *mixbuf;
+};
+
+static int NUVIXAUDIO_OpenDevice(SDL_AudioDevice *device, const char *devname)
+{
+    NuvixAudioInfo info;
+    Uint32 frame_bytes, samples;
+
+    (void)devname;
+    device->hidden = (struct SDL_PrivateAudioData *)SDL_calloc(1, sizeof(*device->hidden));
+    if (!device->hidden) {
+        return SDL_OutOfMemory();
+    }
+
+    device->hidden->fd = open(NUVIX_AUDIO_DEVICE, O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    if (device->hidden->fd < 0) {
+        return SDL_SetError("Could not open %s: %s", NUVIX_AUDIO_DEVICE, strerror(errno));
+    }
+    if (ioctl(device->hidden->fd, NUVIX_AUDIO_INFO, &info) < 0) {
+        return SDL_SetError("AUDIO_INFO failed: %s", strerror(errno));
+    }
+    if (!info.rate || info.rate > SDL_MAX_SINT32 || info.bits != 16 ||
+        !info.channels || info.channels > 2) {
+        return SDL_SetError("Invalid Nuvix PCM format");
+    }
+
+    frame_bytes = info.channels * sizeof(Sint16);
+    samples = info.period_bytes / frame_bytes;
+    if (!samples || samples > SDL_MAX_UINT16 || info.period_bytes % frame_bytes) {
+        return SDL_SetError("Invalid Nuvix PCM period size");
+    }
+
+    device->spec.freq = (int)info.rate;
+    device->spec.format = AUDIO_S16LSB;
+    device->spec.channels = (Uint8)info.channels;
+    device->spec.samples = (Uint16)samples;
+    SDL_CalculateAudioSpec(&device->spec);
+
+    device->hidden->mixbuf = (Uint8 *)SDL_malloc(device->spec.size);
+    if (!device->hidden->mixbuf) {
+        return SDL_OutOfMemory();
+    }
+    SDL_memset(device->hidden->mixbuf, device->spec.silence, device->spec.size);
+    return 0;
+}
+
+static Uint8 *NUVIXAUDIO_GetDeviceBuf(SDL_AudioDevice *device)
+{
+    return device->hidden->mixbuf;
+}
+
+static void NUVIXAUDIO_PlayDevice(SDL_AudioDevice *device)
+{
+    struct SDL_PrivateAudioData *hidden = device->hidden;
+    struct pollfd writable = { hidden->fd, POLLOUT, 0 };
+
+    for (;;) {
+        ssize_t written;
+
+        if (SDL_AtomicGet(&device->shutdown)) {
+            return;
+        }
+        written = write(hidden->fd, hidden->mixbuf, device->spec.size);
+        if (written == (ssize_t)device->spec.size) {
+            return;
+        }
+        if (written >= 0) {
+            SDL_SetError("Nuvix audio accepted an incomplete PCM period");
+            break;
+        }
+        if (errno == EINTR) {
+            continue;
+        }
+        if (errno != EAGAIN && errno != EWOULDBLOCK) {
+            SDL_SetError("Nuvix audio write failed: %s", strerror(errno));
+            break;
+        }
+
+        /* Check for SDL shutdown even when the playback queue stays full. */
+        if (poll(&writable, 1, NUVIX_POLL_WAIT_MS) < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            SDL_SetError("Nuvix audio poll failed: %s", strerror(errno));
+            break;
+        }
+        if (writable.revents & (POLLERR | POLLHUP | POLLNVAL)) {
+            SDL_SetError("Nuvix audio device stopped accepting PCM");
+            break;
+        }
+    }
+
+    SDL_OpenedAudioDeviceDisconnected(device);
+}
+
+static void NUVIXAUDIO_CloseDevice(SDL_AudioDevice *device)
+{
+    struct SDL_PrivateAudioData *hidden = device->hidden;
+
+    if (hidden->fd >= 0) {
+        close(hidden->fd);
+    }
+    SDL_free(hidden->mixbuf);
+    SDL_free(hidden);
+}
+
+static SDL_bool NUVIXAUDIO_Init(SDL_AudioDriverImpl *impl)
+{
+    impl->OpenDevice = NUVIXAUDIO_OpenDevice;
+    impl->GetDeviceBuf = NUVIXAUDIO_GetDeviceBuf;
+    impl->PlayDevice = NUVIXAUDIO_PlayDevice;
+    impl->CloseDevice = NUVIXAUDIO_CloseDevice;
+    impl->OnlyHasDefaultOutputDevice = SDL_TRUE;
+    return SDL_TRUE;
+}
+
+AudioBootStrap NUVIXAUDIO_bootstrap = {
+    "nuvix", "Nuvix PCM playback", NUVIXAUDIO_Init, SDL_FALSE
+};
+
+#endif /* SDL_AUDIO_DRIVER_NUVIX */
