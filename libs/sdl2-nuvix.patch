diff --git a/src/video/nuvix/SDL_nuvixvideo.c b/src/video/nuvix/SDL_nuvixvideo.c
new file mode 100644
index 0000000..89461e8
--- /dev/null
+++ b/src/video/nuvix/SDL_nuvixvideo.c
@@ -0,0 +1,361 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2025 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "../../SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_NUVIX
+
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/input-event-codes.h>
+#include <stdint.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+#include "../../events/SDL_scancode_tables_c.h"
+#include "../SDL_sysvideo.h"
+
+#define NUVIX_INPUT_DEVICE "/dev/input"
+#define NUVIX_GPU_DEVICE   "/dev/gpu"
+#define NUVIX_GPU_INFO     0x80504700U
+#define NUVIX_GPU_PRESENT  0x00004702U
+#define NUVIX_GPU_BGRX8888 2U
+#define NUVIX_GPU_BUFFERS  6U
+
+typedef struct
+{
+    Uint32 width;
+    Uint32 height;
+    Uint32 stride;
+    Uint32 format;
+    Uint64 length;
+    Uint64 offsets[NUVIX_GPU_BUFFERS];
+    Uint32 index;
+    Uint32 reserved;
+} NuvixGPUInfo;
+
+SDL_COMPILE_TIME_ASSERT(nuvix_gpu_info, sizeof(NuvixGPUInfo) == 80);
+
+/* Nuvix uses Linux event codes but has its own record layout. */
+typedef struct
+{
+    Uint16 type;
+    Uint16 code;
+    Sint32 value;
+} NuvixInputEvent;
+
+SDL_COMPILE_TIME_ASSERT(nuvix_input_event, sizeof(NuvixInputEvent) == 8);
+
+static const Uint8 NUVIX_MouseButtons[] = {
+    SDL_BUTTON_LEFT, SDL_BUTTON_RIGHT, SDL_BUTTON_MIDDLE,
+    SDL_BUTTON_X1, SDL_BUTTON_X2
+};
+
+typedef struct
+{
+    int fd;
+    int input_fd;
+    size_t length;
+    SDL_Surface *buffers[2];
+    Uint32 first_index;
+    unsigned int next_slot;
+    SDL_Window *window;
+    SDL_bool failed;
+} NuvixVideoData;
+
+static int NUVIX_VideoInit(_THIS)
+{
+    NuvixVideoData *data = _this->driverdata;
+    NuvixGPUInfo info;
+    SDL_DisplayMode mode;
+    int display_index;
+    unsigned int slot;
+
+    data->fd = open(NUVIX_GPU_DEVICE, O_RDWR | O_CLOEXEC);
+    if (data->fd < 0) {
+        return SDL_SetError("Could not open %s: %s", NUVIX_GPU_DEVICE, strerror(errno));
+    }
+    if (ioctl(data->fd, NUVIX_GPU_INFO, &info) < 0) {
+        return SDL_SetError("GPU_INFO failed: %s", strerror(errno));
+    }
+    if (info.format != NUVIX_GPU_BGRX8888 || info.index >= NUVIX_GPU_BUFFERS ||
+        !info.width || info.width > SDL_MAX_SINT32 / 4 ||
+        !info.height || info.height > SDL_MAX_SINT32 ||
+        info.stride != info.width * 4 ||
+        info.length != (Uint64)info.stride * info.height || info.length > SDL_MAX_UINT32) {
+        return SDL_SetError("Invalid Nuvix GPU framebuffer layout");
+    }
+
+    data->length = (size_t)info.length;
+    data->first_index = info.index;
+    for (slot = 0; slot < SDL_arraysize(data->buffers); ++slot) {
+        const Uint32 index = (data->first_index + slot) % NUVIX_GPU_BUFFERS;
+        void *pixels = mmap(NULL, data->length, PROT_READ | PROT_WRITE,
+                            MAP_SHARED, data->fd, (off_t)info.offsets[index]);
+        if (pixels == MAP_FAILED) {
+            return SDL_SetError("Could not map Nuvix GPU buffer %u: %s", (unsigned int)index, strerror(errno));
+        }
+        data->buffers[slot] = SDL_CreateRGBSurfaceWithFormatFrom(pixels, (int)info.width, (int)info.height,
+                                                                  32, (int)info.stride, SDL_PIXELFORMAT_BGRX32);
+        if (!data->buffers[slot]) {
+            munmap(pixels, data->length);
+            return -1;
+        }
+    }
+
+    SDL_zero(mode);
+    mode.format = SDL_PIXELFORMAT_BGRX32;
+    mode.w = (int)info.width;
+    mode.h = (int)info.height;
+    display_index = SDL_AddBasicVideoDisplay(&mode);
+    if (display_index < 0) {
+        return -1;
+    }
+    if (!SDL_AddDisplayMode(&_this->displays[display_index], &mode)) {
+        return SDL_OutOfMemory();
+    }
+
+    /* Video still works when no input device is attached. */
+    data->input_fd = open(NUVIX_INPUT_DEVICE, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    return 0;
+}
+
+static void NUVIX_VideoQuit(_THIS)
+{
+    NuvixVideoData *data = _this->driverdata;
+    unsigned int slot;
+
+    for (slot = 0; slot < SDL_arraysize(data->buffers); ++slot) {
+        SDL_Surface *buffer = data->buffers[slot];
+        if (buffer) {
+            void *pixels = buffer->pixels;
+            SDL_FreeSurface(buffer);
+            munmap(pixels, data->length);
+        }
+    }
+    if (data->fd >= 0) {
+        close(data->fd);
+    }
+    if (data->input_fd >= 0) {
+        close(data->input_fd);
+    }
+}
+
+static int NUVIX_CreateWindow(_THIS, SDL_Window *window)
+{
+    NuvixVideoData *data = _this->driverdata;
+
+    if (data->window) {
+        return SDL_SetError("The Nuvix video driver supports one window");
+    }
+    data->window = window;
+    return 0;
+}
+
+static void NUVIX_DestroyWindow(_THIS, SDL_Window *window)
+{
+    NuvixVideoData *data = _this->driverdata;
+
+    if (data->window == window) {
+        data->window = NULL;
+    }
+}
+
+static void NUVIX_DestroyWindowFramebuffer(_THIS, SDL_Window *window)
+{
+    (void)_this;
+    SDL_FreeSurface(window->driverdata);
+    window->driverdata = NULL;
+}
+
+static int NUVIX_CreateWindowFramebuffer(_THIS, SDL_Window *window, Uint32 *format, void **pixels, int *pitch)
+{
+    SDL_Surface *surface;
+    int w, h;
+
+    SDL_GetWindowSizeInPixels(window, &w, &h);
+    surface = SDL_CreateRGBSurfaceWithFormat(0, w, h, 32, SDL_PIXELFORMAT_BGRX32);
+    if (!surface) {
+        return -1;
+    }
+
+    NUVIX_DestroyWindowFramebuffer(_this, window);
+    window->driverdata = surface;
+    *format = surface->format->format;
+    *pixels = surface->pixels;
+    *pitch = surface->pitch;
+    return 0;
+}
+
+static int NUVIX_UpdateWindowFramebuffer(_THIS, SDL_Window *window, const SDL_Rect *rects, int numrects)
+{
+    NuvixVideoData *data = _this->driverdata;
+    SDL_Surface *source = window->driverdata;
+    SDL_Surface *target = data->buffers[data->next_slot];
+    const Uint32 index = (data->first_index + data->next_slot) % NUVIX_GPU_BUFFERS;
+    SDL_Rect area = { 0, 0, target->w, target->h };
+
+    (void)rects;
+    (void)numrects;
+    if (data->failed) {
+        return SDL_SetError("Nuvix GPU is unavailable after a failed submission");
+    }
+
+    if ((Uint64)target->w * source->h <= (Uint64)target->h * source->w) {
+        area.h = SDL_max(1, (int)((Uint64)target->w * source->h / source->w));
+        area.y = (target->h - area.h) / 2;
+    } else {
+        area.w = SDL_max(1, (int)((Uint64)target->h * source->w / source->h));
+        area.x = (target->w - area.w) / 2;
+    }
+    if ((area.w != target->w || area.h != target->h) && SDL_FillRect(target, NULL, 0) < 0) {
+        return -1;
+    }
+    if (SDL_BlitScaled(source, NULL, target, &area) < 0) {
+        return -1;
+    }
+    if (ioctl(data->fd, NUVIX_GPU_PRESENT, (void *)(uintptr_t)index) < 0) {
+        const int error = errno;
+        if (error == ETIMEDOUT || error == EPROTO || error == ENODEV) {
+            data->failed = SDL_TRUE;
+        }
+        return SDL_SetError("GPU_PRESENT failed: %s", strerror(error));
+    }
+
+    data->next_slot = (data->next_slot + 1) % SDL_arraysize(data->buffers);
+    return 0;
+}
+
+static void NUVIX_SendInput(SDL_Window *window, const NuvixInputEvent *event)
+{
+    SDL_Window *mouse_focus = SDL_GetMouseFocus();
+
+    if (event->type == EV_KEY && event->value >= 0 && event->value <= 2) {
+        const Uint8 state = event->value ? SDL_PRESSED : SDL_RELEASED;
+        if (event->code >= BTN_MOUSE && event->code < BTN_MOUSE + SDL_arraysize(NUVIX_MouseButtons)) {
+            if (event->value != 2 && ((window && mouse_focus == window) || state == SDL_RELEASED)) {
+                SDL_SendMouseButton(mouse_focus, 0, state, NUVIX_MouseButtons[event->code - BTN_MOUSE]);
+            }
+        } else if (window && SDL_GetKeyboardFocus() == window) {
+            SDL_SendKeyboardKey(state, SDL_GetScancodeFromTable(SDL_SCANCODE_TABLE_LINUX, event->code));
+        }
+    } else if (event->type == EV_REL && window && mouse_focus == window) {
+        switch (event->code) {
+        case REL_X:
+            SDL_SendMouseMotion(window, 0, 1, event->value, 0);
+            break;
+        case REL_Y:
+            SDL_SendMouseMotion(window, 0, 1, 0, event->value);
+            break;
+        case REL_WHEEL:
+            SDL_SendMouseWheel(window, 0, 0.0f, (float)event->value, SDL_MOUSEWHEEL_NORMAL);
+            break;
+        case REL_HWHEEL:
+            SDL_SendMouseWheel(window, 0, (float)event->value, 0.0f, SDL_MOUSEWHEEL_NORMAL);
+            break;
+        }
+    }
+}
+
+static void NUVIX_ResetInput(void)
+{
+    const Uint32 buttons = SDL_GetMouseState(NULL, NULL);
+    unsigned int i;
+
+    SDL_ResetKeyboard();
+    for (i = 0; i < SDL_arraysize(NUVIX_MouseButtons); ++i) {
+        const Uint8 button = NUVIX_MouseButtons[i];
+        if (buttons & SDL_BUTTON(button)) {
+            SDL_SendMouseButton(SDL_GetMouseFocus(), 0, SDL_RELEASED, button);
+        }
+    }
+}
+
+static void NUVIX_PumpEvents(_THIS)
+{
+    NuvixVideoData *data = _this->driverdata;
+    NuvixInputEvent events[32];
+
+    while (data->input_fd >= 0) {
+        const ssize_t bytes = read(data->input_fd, events, sizeof(events));
+        if (bytes > 0) {
+            size_t i;
+            for (i = 0; i < (size_t)bytes / sizeof(events[0]); ++i) {
+                NUVIX_SendInput(data->window, &events[i]);
+            }
+        } else if (bytes < 0 && errno == EINTR) {
+            continue;
+        } else if (bytes < 0 && errno == EOVERFLOW) {
+            /* Releases may have been lost along with the rest of the queue. */
+            NUVIX_ResetInput();
+        } else {
+            if (bytes == 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
+                close(data->input_fd);
+                data->input_fd = -1;
+                NUVIX_ResetInput();
+            }
+            break;
+        }
+    }
+}
+
+static void NUVIX_DeleteDevice(SDL_VideoDevice *device)
+{
+    SDL_free(device->driverdata);
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *NUVIX_CreateDevice(void)
+{
+    SDL_VideoDevice *device = SDL_calloc(1, sizeof(*device));
+    NuvixVideoData *data = SDL_calloc(1, sizeof(*data));
+
+    if (!device || !data) {
+        SDL_free(device);
+        SDL_free(data);
+        SDL_OutOfMemory();
+        return NULL;
+    }
+
+    data->fd = -1;
+    data->input_fd = -1;
+    device->driverdata = data;
+    device->VideoInit = NUVIX_VideoInit;
+    device->VideoQuit = NUVIX_VideoQuit;
+    device->CreateSDLWindow = NUVIX_CreateWindow;
+    device->DestroyWindow = NUVIX_DestroyWindow;
+    device->CreateWindowFramebuffer = NUVIX_CreateWindowFramebuffer;
+    device->UpdateWindowFramebuffer = NUVIX_UpdateWindowFramebuffer;
+    device->DestroyWindowFramebuffer = NUVIX_DestroyWindowFramebuffer;
+    device->PumpEvents = NUVIX_PumpEvents;
+    device->free = NUVIX_DeleteDevice;
+    /* Window surfaces use the software framebuffer callbacks. */
+    device->checked_texture_framebuffer = SDL_TRUE;
+    return device;
+}
+
+VideoBootStrap NUVIX_bootstrap = {
+    "nuvix", "Nuvix software video driver", NUVIX_CreateDevice, NULL
+};
+
+#endif /* SDL_VIDEO_DRIVER_NUVIX */
